<script>
const tabs = document.querySelectorAll(".side-tab");
const panels = document.querySelectorAll(".demo-panel");

tabs.forEach(tab => {
  tab.addEventListener("click", () => {
    tabs.forEach(item => item.classList.remove("active"));
    panels.forEach(panel => panel.classList.remove("active"));

    tab.classList.add("active");

    const selectedPanel = document.getElementById(tab.dataset.tab);
    if (selectedPanel) {
      selectedPanel.classList.add("active");
    }
  });
});

const taskCheckboxes = document.querySelectorAll(".task-check");

function updateProgress() {
  const total = taskCheckboxes.length;
  const completed = [...taskCheckboxes].filter(box => box.checked).length;
  const percentage = Math.round((completed / total) * 100);

  document.getElementById("checklistCount").textContent =
    completed + " of " + total;

  document.getElementById("checklistBar").style.width =
    percentage + "%";

  document.getElementById("dashboardPercent").textContent =
    percentage + "%";

  document.getElementById("dashboardBar").style.width =
    percentage + "%";

  taskCheckboxes.forEach(box => {
    const row = box.closest(".task-row");
    const title = row.querySelector(".task-info strong");

    if (box.checked) {
      title.style.textDecoration = "line-through";
      title.style.opacity = ".55";
    } else {
      title.style.textDecoration = "none";
      title.style.opacity = "1";
    }
  });
}

taskCheckboxes.forEach(box => {
  box.addEventListener("change", updateProgress);
});

updateProgress();
</script>

